{
  "name": "kuvibe-admin",
  "version": "1.2.2",
  "description": "基于 KuVibe 的 AI 友好 NestJS 后端底座，面向 Vben Admin 管理系统",
  "scripts": {
    "start": "pnpm --dir packages/backend start",
    "start:local": "pnpm --dir packages/backend start:local",
    "start:dev": "pnpm --dir packages/backend start:dev",
    "start:debug": "pnpm --dir packages/backend start:debug",
    "start:prod": "pnpm --dir packages/backend start:prod",
    "build": "pnpm --dir packages/backend build",
    "setup": "pnpm --dir packages/backend setup",
    "lint": "pnpm --dir packages/backend lint",
    "lint:check": "pnpm --dir packages/backend lint:check",
    "typecheck": "pnpm --dir packages/backend typecheck",
    "test": "pnpm --dir packages/backend test",
    "test:watch": "pnpm --dir packages/backend test:watch",
    "test:cov": "pnpm --dir packages/backend test:cov",
    "test:e2e": "pnpm --dir packages/backend test:e2e",
    "test:release": "pnpm --dir packages/backend test:release",
    "test:upload:integration": "pnpm --dir packages/backend test:upload:integration",
    "test:timezone:integration": "pnpm --dir packages/backend test:timezone:integration",
    "test:migration:integration": "pnpm --dir packages/backend test:migration:integration",
    "migration:create": "pnpm --dir packages/backend migration:create",
    "migration:generate": "pnpm --dir packages/backend migration:generate",
    "migration:run": "pnpm --dir packages/backend migration:run",
    "migration:show": "pnpm --dir packages/backend migration:show",
    "migration:revert": "pnpm --dir packages/backend migration:revert",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview",
    "vben:contract:collect": "node ./scripts/vben-contract.mjs generate --write",
    "vben:contract:check": "node ./scripts/vben-contract.mjs check",
    "vben:contract:diff": "node ./scripts/vben-contract.mjs diff",
    "vben:contract:test": "node --test ./scripts/vben-contract.test.mjs",
    "vben:contract:warn-main": "node ./scripts/vben-contract.mjs warn-main --ref main",
    "test:setup:integration": "pnpm --dir packages/backend test:setup:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumvjs/KuVibeAdmin.git"
  },
  "homepage": "https://github.com/kumvjs/KuVibeAdmin",
  "bugs": {
    "url": "https://github.com/kumvjs/KuVibeAdmin/issues"
  }
}