# app
APP_NAME = KuVibeAdmin
APP_PORT = 7001
APP_BASE_URL = http://localhost:${APP_PORT}
APP_LOCALE = zh-CN
PROJECT_DIR = /nest-ai-boot

# Browser / Vben security (local defaults shown)
# Production requires APP_BASE_URL and every APP_CORS_ORIGINS entry to use HTTPS.
APP_CORS_ORIGINS = http://localhost:5999,http://localhost:5555
AUTH_COOKIE_SECURE = false
# Cross-site deployments must use none together with AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAME_SITE = lax
# Leave unset for a host-only Refresh Token Cookie (recommended).
# AUTH_COOKIE_DOMAIN = api.example.com

# swagger
SWAGGER_ENABLE = true
SWAGGER_PATH = api-docs
SWAGGER_VERSION = 1.0

# logger
# 默认空是输出所有日志
LOGGER_LOG_LEVELS =
LOGGER_TIMESTAMP =
LOGGER_PREFIX =
LOGGER_JSON = true
LOGGER_COLORS =
LOGGER_COMPACT =
LOGGER_DEPTH =

# TypeOrm
TYPEORM_TYPE=postgres
TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=5432
TYPEORM_USERNAME=nest_ai_boot
TYPEORM_PASSWORD=
TYPEORM_DATABASE=nest_ai_boot
TYPEORM_SCHEMA=nest_ai_boot
#TYPEORM_SYNCHRONIZE=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
# 请使用随机字符
JWT_SECRET=
JWT_EXPIRE=86400 # 单位秒
# 请使用随机字符
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=2592000 # 单位秒
