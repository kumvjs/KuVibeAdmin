{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": [
      "jest",
      "node"
    ],
    "resolvePackageJsonExports": false,
    "paths": {
      "#/*": ["src/*"],
      "file-type": ["node_modules/file-type/source/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.spec.ts",
    "src/shared/cache/types.d.ts",
    "types/**/*.d.ts"
  ]
}
