# 根目录 Compose 配置。node scripts/docker-init.mjs 自动生成五个独立随机密钥。
# 不与 packages/backend/.env.local 混用。
NODE_ENV=local
DOCKER_HTTP_BIND=127.0.0.1
DOCKER_HTTP_PORT=7001
APP_BASE_URL=http://localhost:7001
APP_CORS_ORIGINS=http://localhost:5999,http://localhost:5555
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# 留空使用 host-only Cookie。
AUTH_COOKIE_DOMAIN=
GLOBAL_PREFIX=api
SWAGGER_ENABLE=true

POSTGRES_USER=ku_vibe_admin
POSTGRES_DB=ku_vibe_admin
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
REFRESH_TOKEN_SECRET=
RABBITMQ_ENABLED=true
RABBITMQ_USERNAME=ku_vibe_admin
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=kuvibe
RABBITMQ_PREFETCH=5
RABBITMQ_QUEUE=kuvibe.billing
TASK_LOG_RETENTION_DAYS=30
TASK_EXECUTION_CONCURRENCY=2
# 管理界面始终绑定127.0.0.1；开发环境默认15673，AMQP默认5673。
DOCKER_RABBITMQ_MANAGEMENT_PORT=15672

# 可固定已经验证的镜像 tag 或 digest；不要直接切换已有数据库卷的主版本。
NODE_IMAGE=node:24-bookworm-slim
POSTGRES_IMAGE=postgres:18.6-bookworm
REDIS_IMAGE=redis:8-bookworm
RABBITMQ_IMAGE=rabbitmq:4.3.6-management
