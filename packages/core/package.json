{
  "name": "@kumvjs/nest-ai-boot",
  "type": "module",
  "version": "1.1.1",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "imports": {
    "#/*": "./dist/src/*"
  },
  "scripts": {
    "build": "nest build",
    "setup": "pnpm build && cross-env NODE_ENV=local node dist/src/scripts/setup.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:local": "cross-env NODE_ENV=local nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:upload:integration": "nest build && cross-env NODE_ENV=test TYPEORM_TYPE=postgres node test/upload.integration.mjs",
    "test:database-config": "nest build && node --test test/database-config.test.mjs",
    "typeorm": "cross-env NODE_ENV=local typeorm",
    "migration:create": "pnpm typeorm migration:create ./src/migrations/initData",
    "migration:generate": "pnpm build && pnpm typeorm -d ./dist/src/config/database.config.js migration:generate ./src/migrations/update-table",
    "migration:run": "pnpm build && pnpm typeorm -d ./dist/src/config/database.config.js migration:run",
    "migration:check": "pnpm build && pnpm typeorm -d ./dist/src/config/database.config.js migration:check",
    "migration:show": "pnpm build && pnpm typeorm -d ./dist/src/config/database.config.js migration:show",
    "migration:revert": "pnpm build && pnpm typeorm -d ./dist/src/config/database.config.js migration:revert",
    "test:timezone": "cross-env TYPEORM_TYPE=postgres node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand src/utils/time.util.spec.ts src/modules/timezone",
    "test:timezone:integration": "nest build && node --test test/timezone.integration.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@liaoliaots/nestjs-redis": "^10.0.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "argon2": "0.45.1",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "file-type": "22.0.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.5",
    "mysql2": "^3.24.2",
    "nanoid": "^6.0.1",
    "nestjs-asyncapi": "^2.0.1",
    "nestjs-paginate": "^15.0.1",
    "openai": "^7.8.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "qs": "^6.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "typeorm": "^1.1.1",
    "ua-parser-js": "^2.0.10",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.69.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^#/(.*)\\.js$": "<rootDir>/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    }
  }
}