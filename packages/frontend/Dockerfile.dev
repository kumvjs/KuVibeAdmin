ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE}
ARG NPM_REGISTRY=https://registry.npmjs.org
ENV CI=true
RUN npm install --global pnpm@11.16.0
RUN mkdir -p /workspace/frontend && chown node:node /workspace/frontend
USER node
WORKDIR /workspace/frontend
COPY --chown=node:node . .
RUN --mount=type=cache,id=kuvibe-frontend-pnpm-store,target=/pnpm/store,uid=1000,gid=1000 pnpm install --frozen-lockfile --store-dir /pnpm/store --registry="${NPM_REGISTRY}"
RUN cp playground/.env.example playground/.env
WORKDIR /workspace/frontend/playground
EXPOSE 5999
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5999", "--strictPort"]
